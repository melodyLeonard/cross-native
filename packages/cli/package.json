{
  "name": "@cross-native/cli",
  "version": "0.1.0",
  "description": "CLI for CrossNative — compile, build, and run native modules",
  "bin": {
    "cross-native": "bin/cross-native.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts",
    "dev": "tsup src/index.ts --format cjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "inquirer": "^9.2.0",
    "chokidar": "^3.6.0",
    "which": "^4.0.0",
    "fast-glob": "^3.3.0",
    "fs-extra": "^11.2.0",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "vitest": "^1.4.0",
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@types/mustache": "^4.2.0",
    "@types/which": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
