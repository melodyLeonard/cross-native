  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  },
  "dependencies": {
    "@cross-native/core": "0.1.0-alpha.1",
    "@cross-native/compiler": "0.1.0-alpha.1"
