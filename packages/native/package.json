{
  "name": "react-native-cross-native",
  "version": "0.1.0-alpha.7",
  "description": "CrossNative - run compiled languages off the JS thread via JSI + WASM",
  "main": "dist/index.js",
  "files": [
    "dist",
    "android",
    "ios",
    "cpp",
    "jsi",
    "wamr/core",
    "*.podspec",
    "react-native.config.js",
    "README.md",
    "metro-transformer.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "clean": "rm -rf lib",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "react-native",
    "native-modules",
    "rust",
    "wasm",
    "threads",
    "performance",
    "jsi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/melodyLeonard/cross-native.git"
  },
  "author": "CrossNative Contributors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/melodyLeonard/cross-native/issues"
  },
  "homepage": "https://github.com/melodyLeonard/cross-native#readme",
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@cross-native/core": "0.1.0-alpha.7",
    "@cross-native/compiler": "0.1.0-alpha.7"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.73.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-native": {
      "optional": false
    }
  },
  "types": "dist/index.d.ts"
}
